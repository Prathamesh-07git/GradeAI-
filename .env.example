# Database Connection (Leave empty or sqlite for local, or paste Render Postgres URL for production)
DATABASE_URL=postgresql://user:password@localhost:5432/gradeai

# Security Secret Key
SECRET_KEY=dev-secret-key-change-this-in-production

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# NLP Model Selection (Optional override)
MODEL_NAME=all-MiniLM-L6-v2
